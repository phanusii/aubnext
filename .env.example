DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_results?schema=public"
# (ออปชัน) บังคับ sslmode ของการต่อ Postgres เช่น require/verify-full
# เว้นว่าง = ระบบยกระดับ verify-ca → verify-full อัตโนมัติ (ปิดช่อง MITM + ตัด SECURITY warning)
PG_SSLMODE=""
AUTH_SECRET="change-this-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"
NEXT_PUBLIC_LIFF_ID=""
